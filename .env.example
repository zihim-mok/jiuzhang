# 复制为 .env 后填写；.env 已被 .gitignore 排除，不随代码打包、不入日志
# 优先级：真实环境变量 > config.yaml > .env > 默认值
# 说明：api_key 若仍是占位文本（含 REPLACE_ME / YOUR_KEY / <...>），系统按「未配置」处理，
#       自动运行在模拟替身模式（零网络请求），healthz 会提示 key_state=placeholder。

# ---- 业务写策略开关（切换后需重启服务） ----
# all（默认）  = 全部写能力开放：退订 L1、转账/定时任务 L2，均走确认流程
# cancel_only = 仅放行订阅退订，转账/定时任务仍拒绝
# readonly    = 全部业务写拒绝，只提供查询与分析
BUSINESS_WRITES=all

# ---- 主模型（三选一：deepseek / glm / qwen，接口需 OpenAI 兼容） ----
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-flash
MODEL_API_BASE=https://api.deepseek.com/v1
MODEL_API_KEY=sk-REPLACE_ME_WITH_YOUR_KEY

# ---- AI 增强：仅对只读/普通对话优先模型识别；写操作保持规则 + 确认 ----
# ai_first = 只读业务优先 AI；rule_first = 规则优先。AI 不能发起任何写操作。
MODEL_INTENT_STRATEGY=ai_first
# on = 开启只读衔接与财务常识；off = 保留固定回复
MODEL_REPLY_MODE=on
# 生成回复超时（秒）；失败不影响原规则回复
MODEL_REPLY_TIMEOUT_SECONDS=6

# ---- 备用模型（可选；主模型连续失败达阈值后切换） ----
# MODEL_FALLBACK_PROVIDER=glm
# MODEL_FALLBACK_API_BASE=https://open.bigmodel.cn/api/paas/v4
# MODEL_FALLBACK_API_KEY=REPLACE_ME
